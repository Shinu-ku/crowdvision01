# ─────────────────────────────────────────────────────────────
# CrowdVision Platform - Unified Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env or configure sub-services in backend/.env and ai_agent/.env

# ──── Backend API (:8000) ────
APP_NAME=CrowdVision Platform API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (Default: local SQLite; Production: postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=sqlite+aiosqlite:///./crowdvision_main.db
DATA_RETENTION_DAYS=30

# Video Processing & Computer Vision Limits
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=14400
MAX_VIDEO_DIMENSION=4096
SAMPLE_FPS=2.0
INFERENCE_WIDTH=640
INFERENCE_CONFIDENCE=0.35
YOLO_MODEL_PATH=models/yolov8n.onnx

# ──── Independent AI Agent Subsystem (:8100) ────
AI_AGENT_BASE_URL=http://localhost:8100
AI_AGENT_API_KEY=replace_with_shared_agent_api_key
AI_AGENT_TIMEOUT_SECONDS=5.0
AI_AGENT_ENABLED=true

# Optional LLM Integration (for conversational operator reasoning)
GEMINI_API_KEY=replace_with_gemini_api_key_if_enabled
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs Voice Announcements for CrowdVision Alerts
ELEVENLABS_API_KEY=sk_c4962bc6788d34dd105a6de111212c2e9c862c44919e3b2b
ELEVENLABS_VOICE_ID=tnSpp4vdxKPjI9w0GnoV
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_ENABLED=true
